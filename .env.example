# ============================================================
# AI Maths Teacher — Environment Configuration Template
# Copy to .env and fill in values before running.
# NEVER commit .env to source control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/math_teacher

# --- Groq Cloud LLM (Primary & Fallback) ---
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_FALLBACK=gsk_your_secondary_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings (Sentence-Transformers / Local CPU) ---
# sentence-transformers/all-mpnet-base-v2 produces 768-dimensional vectors
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# --- Retrieval Tuning ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# --- RAG Quality & Thresholds ---
GROUNDING_THRESHOLD=0.80
MAX_AGENT_RETRIES=2

# --- Context & Chunking Limits ---
MAX_CONTEXT_CHARS=12000
MAX_CHUNK_CHARS=1800

# --- Admin API Key (protects /api/v1/ingest) ---
# Set a strong random value for production use
ADMIN_API_KEY=change-me-before-deploy
